# ============================================================
# Commentarium System - Environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is git-ignored).
# ============================================================

# --- AI Provider (OpenRouter/chat gateway) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: custom base URL (e.g. for a proxy or alternative gateway).
# Leave empty to use the official https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- Default models (can be changed later in the UI Settings page) ---
# Any model id from https://openrouter.ai/models
CHAT_MODEL=
EMBEDDING_MODEL=
# Default sampling temperature (0.0-1.5; lower = more factual). Can be
# overridden per-project from the Chat page.
CHAT_TEMPERATURE=0.2

# --- Embedding backend ---
# "local"      -> sentence-transformers, free & private (default)
# "api"        -> any OpenAI-compatible /embeddings endpoint (OpenRouter,
#                 Google Gemini, OpenAI, LM Studio…) using the dedicated
#                 base url/key/model below (falls back to the OpenRouter gateway
#                 settings when those are empty)
# "cloudflare" -> Cloudflare Workers AI embeddings (uses CF_ACCOUNT_ID/CF_API_TOKEN)
EMBEDDING_BACKEND=local

# Local (offline) embedding model. Either a HuggingFace id (downloaded once) or a
# LOCAL_EMBEDDING_PATH pointing at a model FOLDER (config.json + model.safetensors)
# for 100%-offline use.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: absolute path to a local model folder. Empty = use the id above.
LOCAL_EMBEDDING_PATH=
# "1" = never download; use only the local cache/folder (fixes the
# "cannot connect to huggingface.co" proxy error).
HF_OFFLINE=0

# OpenAI-compatible embedding endpoint (EMBEDDING_BACKEND=api).
# Leave both empty to reuse the OpenRouter gateway above.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# Cloudflare Workers AI embedding model (EMBEDDING_BACKEND=cloudflare).
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8

# --- Citations ---
# Default style for chat answers + reference previews:
# "apa" | "vancouver"
CITATION_STYLE=apa

# --- OCR ---
# "tesseract"     -> local OCR, free & private (requires Tesseract installed)
# "vision"        -> use CHAT_MODEL with vision (costs tokens)
# "paddleocr-vl"  -> PaddleOCR-VL-1.6 via a local VLM server, else gateway vision
# "teleocr"       -> TeleOCR via a local VLM server, else gateway vision
# "disabled"      -> skip OCR entirely (text-only PDFs)
OCR_BACKEND=tesseract
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Default indexing mode (used when you upload/ingest without choosing) ---
# This controls whether the "OCR + index" or "direct index" path runs by default.
# You can still pick per-upload / per-document from the Projects page.
#   "true"  -> OCR + indexing (scanned/image pages are OCR'd before embedding)
#   "false" -> Direct indexing (text extracted only; no OCR — faster)
DEFAULT_OCR=true

# --- Vision-language OCR models ---
# HF ids used when OCR_BACKEND is one of the above. *_BASE_URL points at a
# local OpenAI-compatible server (/chat/completions). If empty, the gateway's
# vision model is used instead.
PADDLEOCR_VL_MODEL=PaddleOCR-community/PaddleOCR-VL-1.6
PADDLEOCR_VL_BASE_URL=
# TeleOCR: vLLM / SGLang / Ollama-LM-Studio etc. serve this id.
TELEOCR_MODEL=XingChen-AGI/TeleOCR
TELEOCR_BASE_URL=

# --- Podcast (NotebookLM-style) ---
# TTS provider:
#   "edge-tts"   -> free MP3 audio (needs `pip install edge-tts` + internet)
#   "localhost"  -> your OpenAI-compatible /v1/audio/speech endpoint (private)
#   "voicestudio" -> local VoiceStudio server (voice cloning/design, fully local)
#   "cloudflare" -> Cloudflare Workers AI TTS (needs CF_ACCOUNT_ID/CF_API_TOKEN)
#   "google"     -> Google Cloud Text-to-Speech (needs GOOGLE_API_KEY)
#   "disabled"   -> transcript only (no audio)
TTS_PROVIDER=edge-tts

# Localhost OpenAI-compatible speech endpoint (TTS_PROVIDER=localhost).
TTS_API_URL=http://localhost:20128/v1/audio/speech
TTS_API_KEY=
TTS_API_MODEL=tts-1
TTS_API_FORMAT=mp3

# VoiceStudio local server (TTS_PROVIDER=voicestudio).
# https://github.com/debpalash/VoiceStudio — the running backend exposes an
# OpenAI-compatible API on :3900. Loopback needs no key; supply one only for a
# VoiceStudio on another host. Each host's voice is a VoiceStudio profile ID.
VOICESTUDIO_URL=http://localhost:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_MODEL=           # empty = active engine (omnivoice)
VOICESTUDIO_FORMAT=mp3       # mp3 | wav | opus | aac | flac | pcm (wav/flac/pcm need no VoiceStudio ffmpeg)

# Cloudflare Workers AI TTS (TTS_PROVIDER=cloudflare).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/microsoft/windows-captioning-or-tts

# Google Cloud Text-to-Speech (TTS_PROVIDER=google).
GOOGLE_API_KEY=
GOOGLE_LANGUAGE_CODE=en-US

# --- Podcast hosts (1-3 people, each with name, gender, voice + language) ---
# HOST_LANGUAGE is the ISO 639-1 default code used for the VoiceStudio provider
# ("en" = English, "fa" = Persian/Farsi). It drives script language and synthesis.
# You can override it per episode from the Podcast page; this value is the
# fallback default. default "en".
PODCAST_NUM_HOSTS=2
PODCAST_HOST_1_NAME=Alice
PODCAST_HOST_1_GENDER=female
PODCAST_HOST_1_LANGUAGE=en
PODCAST_HOST_1_VOICE=af_heart
PODCAST_HOST_2_NAME=Sam
PODCAST_HOST_2_GENDER=male
PODCAST_HOST_2_LANGUAGE=en
PODCAST_HOST_2_VOICE=bm_george
PODCAST_HOST_3_NAME=Priya
PODCAST_HOST_3_GENDER=female
PODCAST_HOST_3_LANGUAGE=en
PODCAST_HOST_3_VOICE=af_bella

# --- Storage ---
DATA_DIR=./data

# --- App ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
